.program floppy_tx
top:
.wrap_target
    out x, 1        [14]   ; shift bit into X, burn 15 cycles
    jmp !x no_pulse        ; if X=0, no pulse 1 cycle
    set pindirs, 1  [4]    ; 5 cycles high = 256ns
    set pindirs, 0  [9]    ; 10 cycles low    
    jmp top                ; 1 cycle
no_pulse:
    nop             [15]   ; burn 16 cycles
.wrap


.program floppy_tx_pico2
top:
.wrap_target
    out x, 1        [17]   ; 18 cycles
    jmp !x no_pulse        ; if X=0, no pulse 1 cycle
    set pindirs, 1  [4]    ; 5 cycles
    set pindirs, 0  [11]   ; 12 cycles
    jmp top                ; 1 cycle
no_pulse:
    nop             [16]   ; 17 cycles
.wrap



.program drive_select
.wrap_target
    wait 0 pin 0        ; wait for SELECT to go low (asserted)
    set pindirs, 1      ; immediately assert READY
    wait 1 pin 0        ; wait for SELECT to go high (deasserted)  
    set pindirs, 0     ; immediately deassert READY
.wrap


.program step_capture
top:
.wrap_target
    wait 0 pin 0        ; wait for STEP low
    wait 1 pin 0        ; wait for STEP rising edge
    jmp pin top         ; if SELECT high, go back to top
    in pins, 2          ; capture STEP, DIR
    push noblock        
.wrap


.program floppy_rx
top:
.wrap_target
    jmp x-- chk        ; decrement X, fall through to chk
chk:
    jmp pin top        ; if pin HIGH, jump back to top (keep waiting)
                       ; got falling edge - pin is LOW and fell through
    mov isr, x
    push noblock
wait_high:
    jmp pin top        ; pin HIGH, jump to top
    jmp x-- wait_high  ; still LOW, decrement and loop
.wrap